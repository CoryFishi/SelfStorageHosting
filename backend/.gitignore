# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# `.env` alone matches only that exact name, leaving `.env.local` and
# `.env.production` -- which would hold a real MONGODB_URI and JWT_SECRET --
# untracked by the rule and therefore committable.
.env
.env.*
!.env.example

