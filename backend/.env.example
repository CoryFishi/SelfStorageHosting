PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=selfstoragehosting
# Required in production: a real secret of at least 32 characters. Left
# empty here on purpose so this file can never be copied straight into a
# working production config -- a placeholder value would be a publicly
# known signing key.
JWT_SECRET=
CORS_ORIGINS=http://localhost:3000
